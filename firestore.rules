rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function userRole() { return getUserData().role; }
    function isAdmin() { return isAuthenticated() && userRole() == 'admin'; }
    function isOfficerOrAbove() { return isAuthenticated() && userRole() in ['admin', 'officer']; }
    function isTeacherOrAbove() { return isAuthenticated() && userRole() in ['admin', 'officer', 'teacher']; }
    function isActiveUser() { return isAuthenticated() && getUserData().status == 'active'; }
    function touchesProtectedFields() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasAny(['role', 'status', 'isAdmin', 'permissions', 'accountStatus']);
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId && request.resource.data.role == 'viewer' && request.resource.data.status == 'active';
      allow create: if isAdmin();
      allow update: if isAuthenticated() && request.auth.uid == userId && !touchesProtectedFields();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read: if isActiveUser();
      allow create: if isOfficerOrAbove() && isActiveUser() && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.assetCode is string && request.resource.data.assetCode.size() > 0 && request.resource.data.quantity is number && request.resource.data.quantity >= 0;
      allow update: if isOfficerOrAbove() && isActiveUser() && (request.resource.data.quantity == null || request.resource.data.quantity >= 0);
      allow delete: if isAdmin() && isActiveUser();
    }

    match /categories/{catId} {
      allow read: if isAuthenticated();
      allow write: if isOfficerOrAbove() && isActiveUser();
    }

    match /locations/{locId} {
      allow read: if isAuthenticated();
      allow write: if isOfficerOrAbove() && isActiveUser();
    }

    match /borrowings/{borrowId} {
      allow read: if isOfficerOrAbove() && isActiveUser();
      allow read: if isTeacherOrAbove() && isActiveUser() && resource.data.borrowerUid == request.auth.uid;
      allow create: if isTeacherOrAbove() && isActiveUser() && request.resource.data.quantity is number && request.resource.data.quantity > 0;
      allow update: if isOfficerOrAbove() && isActiveUser();
      allow delete: if isAdmin() && isActiveUser();
    }

    match /maintenance/{reportId} {
      allow read: if isOfficerOrAbove() && isActiveUser();
      allow read: if isTeacherOrAbove() && isActiveUser() && resource.data.createdByUid == request.auth.uid;
      allow create: if isTeacherOrAbove() && isActiveUser();
      allow update: if isOfficerOrAbove() && isActiveUser();
      allow delete: if isAdmin() && isActiveUser();
    }

    match /transfers/{transferId} {
      allow read: if isOfficerOrAbove() && isActiveUser();
      allow write: if isOfficerOrAbove() && isActiveUser();
    }

    match /activityLogs/{logId} {
      allow read: if isOfficerOrAbove() && isActiveUser();
      // Users may only create audit entries under their own identity.
      allow create: if isActiveUser() && request.resource.data.userId == request.auth.uid && request.resource.data.userEmail == request.auth.token.email && request.resource.data.userRole == userRole() && request.resource.data.timestamp == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isOfficerOrAbove() && isActiveUser();
      allow write: if isAdmin() && isActiveUser();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
